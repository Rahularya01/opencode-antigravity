{
  "name": "@rahularya01/opencode-antigravity",
  "version": "0.5.0",
  "description": "OpenCode plugin that provides Google Antigravity / Cloud Code Assist models (Gemini, Claude, GPT-OSS) to OpenCode via an AI SDK LanguageModelV3 provider.",
  "author": "Rahul Arya",
  "license": "MIT",
  "type": "module",
  "main": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./server": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js",
      "default": "./dist/sdk.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "antigravity",
    "google",
    "gemini",
    "claude",
    "ai-sdk"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun test --timeout=15000",
    "typecheck": "tsc --noEmit",
    "ci": "bun install --frozen-lockfile && bun run typecheck && bun run test && bun run build"
  },
  "peerDependencies": {
    "@ai-sdk/provider": "^3.0.0",
    "@opencode-ai/plugin": "^1.0.0"
  },
  "devDependencies": {
    "@ai-sdk/provider": "3.0.15",
    "@opencode-ai/plugin": "1.18.26",
    "@types/bun": "1.4.0",
    "typescript": "5.9.3"
  }
}
